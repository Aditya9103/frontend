# ── Frontend Environment Configuration ──────────────────────────────────────
# API Base URL (Backend Express API)
VITE_API_BASE_URL=http://localhost:5001/api/v1

# Socket.IO Gateway URL (Real-time events, notifications, discussions)
VITE_SOCKET_URL=http://localhost:5001

# Razorpay Public API Key
VITE_RAZORPAY_KEY_ID=rzp_test_mock_key_12345

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=mock-google-client-id-xyz.apps.googleusercontent.com

# Sentry DSN (Error reporting & performance monitoring)
VITE_SENTRY_DSN=
